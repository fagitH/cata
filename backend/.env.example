APP_NAME="CATA Foundation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cata_foundation
DB_USERNAME=root
DB_PASSWORD=

# ACLEDA UAT card-payment settings. Obtain all values from ACLEDA and do not expose them to the browser.
ACLEDA_LOGIN_ID=
ACLEDA_PASSWORD=
ACLEDA_MERCHANT_ID=
ACLEDA_MERCHANT_NAME=CATAISLAMIC
ACLEDA_SIGNATURE=
ACLEDA_VERIFY_SSL=true
ACLEDA_OPEN_SESSION_URL=https://epaymentuat.acledabank.com.kh:8443/CATAISLAMIC/XPAYConnectorServiceInterfaceImplV2/XPAYConnectorServiceInterfaceImplV2RS/openSessionV2
ACLEDA_TXN_STATUS_URL=https://epaymentuat.acledabank.com.kh/CATAISLAMIC/XPAYConnectorServiceInterfaceImplV2/XPAYConnectorServiceInterfaceImplV2RS/getTxnStatus
ACLEDA_PAYMENT_PAGE_URL=https://epaymentuat.acledabank.com.kh/CATAISLAMIC/paymentPage.jsp
FRONTEND_URL=http://localhost:5173
